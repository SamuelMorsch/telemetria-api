# Copie para .env (cp .env.example .env) e preencha. NUNCA envie o .env ao GitHub.
DOMAIN=telemetria-tcc.duckdns.org
POSTGRES_USER=telemetria
# Gere uma senha forte com:  openssl rand -hex 24
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=telemetria

# Segredo que assina os tokens de login. Gere com:  openssl rand -hex 32
# Se vazar, qualquer pessoa consegue forjar logins: trate como senha.
JWT_SECRET=troque-por-um-segredo-de-64-caracteres

# Versão (tag) da imagem do painel publicada pelo CI: main (produção) ou v2 (desenvolvimento)
PAINEL_TAG=main

# Opcionais
# JWT_EXPIRES_IN=8h
# CORS_ORIGINS=http://localhost:3001        (só para desenvolver o painel no seu computador; remova depois)
# REGISTRATION_ENABLED=true                 (false fecha o cadastro público de oficinas)
